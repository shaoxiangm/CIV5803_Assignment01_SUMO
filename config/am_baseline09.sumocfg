<?xml version="1.0" encoding="UTF-8"?>
<sumoConfiguration>
    <input>
        <net-file value="../network/george_town_core_v3.net.xml"/>
        <route-files value="../demand/am_baseline08.rou.xml"/>
        <additional-files value="../additional/am_outputs.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="6300"/>
    </time>
    <random_number>
        <seed value="5803"/>
    </random_number>
    <output>
        <tripinfo-output value="../outputs/generated/tripinfo.xml.gz"/>
        <tripinfo-output.write-unfinished value="true"/>
        <queue-output value="../outputs/generated/queue.xml.gz"/>
        <queue-output.period value="60"/>
        <summary-output value="../outputs/generated/summary.xml"/>
        <summary-output.period value="60"/>
        <fcd-output value="../outputs/generated/fcd.xml.gz"/>
        <fcd-output.attributes value="speed,acceleration,distance,waitingTime"/>
    </output>
    <processing>
        <ignore-route-errors value="false"/>
        <time-to-teleport value="-1"/>
    </processing>
    <report>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
        <verbose value="false"/>
    </report>
</sumoConfiguration>
